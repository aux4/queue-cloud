{
  "scope": "aux4",
  "name": "cloud-queue",
  "version": "0.2.3",
  "description": "aux4.cloud provider plugin for aux4/queue's work-queue mode (--provider cloud) -- delegates to aux4/queue-sqs (installed separately alongside this plugin) with env+scope-prefixed queue names and cloud defaults",
  "license": "Apache-2.0",
  "tags": [
    "aux4",
    "queue",
    "cloud",
    "sqs",
    "aws",
    "messaging",
    "plugin"
  ],
  "dependencies": [
    "aux4/queue"
  ],
  "system": [
    [
      "test:aws --version",
      "brew:awscli",
      "apt:awscli",
      "dnf:awscli"
    ]
  ],
  "profiles": [
    {
      "name": "queue",
      "commands": [
        {
          "name": "cloud",
          "execute": [
            "profile:queue:cloud"
          ],
          "private": true,
          "help": {
            "text": "cloud provider dispatch target (internal)"
          }
        }
      ]
    },
    {
      "name": "queue:cloud",
      "commands": [
        {
          "name": "start",
          "execute": [
            "log:sqs storage ready via aux4/cloud-queue (env=${env}, scope=${scope}, region=${region}); no server process needed"
          ],
          "private": true,
          "help": {
            "text": "cloud provider: validate readiness (no server process)",
            "variables": [
              {
                "name": "env",
                "text": "aux4.cloud environment prefix for the underlying SQS queue name. Resolved from --env or the AUX4_CLOUD_ENV environment variable aux4.cloud machines set on deploy",
                "default": "",
                "env": "AUX4_CLOUD_ENV"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope prefix for the underlying SQS queue name. Resolved from --scope or the AUX4_CLOUD_SCOPE environment variable aux4.cloud machines set on deploy",
                "default": "",
                "env": "AUX4_CLOUD_SCOPE"
              },
              {
                "name": "region",
                "text": "AWS region for the underlying SQS queues",
                "default": "us-east-1"
              }
            ]
          }
        },
        {
          "name": "stop",
          "execute": [
            "log:aux4/cloud-queue: nothing to stop"
          ],
          "private": true,
          "help": {
            "text": "cloud provider: no-op",
            "variables": []
          }
        },
        {
          "name": "create",
          "execute": [
            "if(env==) && echo 'Error: --env is required (or set AUX4_CLOUD_ENV) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "if(scope==) && echo 'Error: --scope is required (or set AUX4_CLOUD_SCOPE) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "nout:echo value(env) value(scope) value(name) | grep -q -- '--'; echo $?",
            "set:hasDoubleDash=${response}",
            "if(hasDoubleDash==0) && echo \"Error: --env/--scope/--name must not contain '--' (reserved as the queue-name field separator)\" && exit 1 || true",
            "set:cloudName=${env}--${scope}--${name}",
            "set:dlqName=${env}--${scope}--${name}-dlq.fifo",
            "nout:echo -n value(dlqName) | grep -qE '^.{81,}$'; echo $?",
            "set:tooLong=${response}",
            "if(tooLong==0) && echo 'Error: resulting queue name' value(cloudName) 'exceeds the 80-character AWS SQS queue-name limit (counting the -dlq.fifo suffix) -- shorten --env/--scope/--name' && exit 1 || true",
            "nout:aux4 queue sqs --help > /dev/null 2>&1; echo $?",
            "set:sqsOk=${response}",
            "if(sqsOk!=0) && echo 'Error: aux4/queue-sqs is not installed. aux4/cloud-queue delegates to it -- run: aux4 aux4 pkger install aux4/queue-sqs' >&2 && exit 1 || true",
            "AWS_DEFAULT_REGION=value(region) aux4 queue sqs create --name value(cloudName) param(maxAttempts)"
          ],
          "private": true,
          "help": {
            "text": "cloud provider: create an env+scope-prefixed durable work queue and its dead-letter queue",
            "variables": [
              {
                "name": "env",
                "text": "aux4.cloud environment prefix for the underlying SQS queue name. Resolved from --env or the AUX4_CLOUD_ENV environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_ENV"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope prefix for the underlying SQS queue name. Resolved from --scope or the AUX4_CLOUD_SCOPE environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_SCOPE"
              },
              {
                "name": "region",
                "text": "AWS region for the underlying SQS queues",
                "default": "us-east-1"
              },
              {
                "name": "name",
                "text": "Queue name (final SQS name is <env>--<scope>--<name>, e.g. dev--myscope--jobs)",
                "default": ""
              },
              {
                "name": "maxAttempts",
                "text": "Maximum delivery attempts before dead-lettering. Defaults to 5 for aux4.cloud deployments (bounded retries), unlike aux4/queue-sqs's own unbounded default",
                "default": "5"
              }
            ]
          }
        },
        {
          "name": "delete",
          "execute": [
            "if(env==) && echo 'Error: --env is required (or set AUX4_CLOUD_ENV) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "if(scope==) && echo 'Error: --scope is required (or set AUX4_CLOUD_SCOPE) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "nout:echo value(env) value(scope) value(name) | grep -q -- '--'; echo $?",
            "set:hasDoubleDash=${response}",
            "if(hasDoubleDash==0) && echo \"Error: --env/--scope/--name must not contain '--' (reserved as the queue-name field separator)\" && exit 1 || true",
            "set:cloudName=${env}--${scope}--${name}",
            "nout:aux4 queue sqs --help > /dev/null 2>&1; echo $?",
            "set:sqsOk=${response}",
            "if(sqsOk!=0) && echo 'Error: aux4/queue-sqs is not installed. aux4/cloud-queue delegates to it -- run: aux4 aux4 pkger install aux4/queue-sqs' >&2 && exit 1 || true",
            "AWS_DEFAULT_REGION=value(region) aux4 queue sqs delete --name value(cloudName) "
          ],
          "private": true,
          "help": {
            "text": "cloud provider: delete an env+scope-prefixed queue and its dead-letter queue",
            "variables": [
              {
                "name": "env",
                "text": "aux4.cloud environment prefix for the underlying SQS queue name. Resolved from --env or the AUX4_CLOUD_ENV environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_ENV"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope prefix for the underlying SQS queue name. Resolved from --scope or the AUX4_CLOUD_SCOPE environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_SCOPE"
              },
              {
                "name": "region",
                "text": "AWS region for the underlying SQS queues",
                "default": "us-east-1"
              },
              {
                "name": "name",
                "text": "Queue name (final SQS name is <env>--<scope>--<name>, e.g. dev--myscope--jobs)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "list",
          "execute": [
            "if(env==) && echo 'Error: --env is required (or set AUX4_CLOUD_ENV) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "if(scope==) && echo 'Error: --scope is required (or set AUX4_CLOUD_SCOPE) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "set:prefix=${env}--${scope}--",
            "AWS_DEFAULT_REGION=value(region) aws sqs list-queues --queue-name-prefix value(prefix) --output json"
          ],
          "private": true,
          "help": {
            "text": "cloud provider: list every queue (including dead-letter queues) whose name starts with this env+scope's prefix, via 'aws sqs list-queues --queue-name-prefix'. There is currently no per-queue access control -- anything running at this env+scope can see and use every queue created at it",
            "variables": [
              {
                "name": "env",
                "text": "aux4.cloud environment prefix for the underlying SQS queue name. Resolved from --env or the AUX4_CLOUD_ENV environment variable aux4.cloud machines set on deploy; required (no default)",
                "default": "",
                "env": "AUX4_CLOUD_ENV"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope prefix for the underlying SQS queue name. Resolved from --scope or the AUX4_CLOUD_SCOPE environment variable aux4.cloud machines set on deploy; required (no default)",
                "default": "",
                "env": "AUX4_CLOUD_SCOPE"
              },
              {
                "name": "region",
                "text": "AWS region for the underlying SQS queues",
                "default": "us-east-1"
              }
            ]
          }
        },
        {
          "name": "send",
          "execute": [
            "if(env==) && echo 'Error: --env is required (or set AUX4_CLOUD_ENV) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "if(scope==) && echo 'Error: --scope is required (or set AUX4_CLOUD_SCOPE) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "nout:echo value(env) value(scope) value(name) | grep -q -- '--'; echo $?",
            "set:hasDoubleDash=${response}",
            "if(hasDoubleDash==0) && echo \"Error: --env/--scope/--name must not contain '--' (reserved as the queue-name field separator)\" && exit 1 || true",
            "set:cloudName=${env}--${scope}--${name}",
            "nout:aux4 queue sqs --help > /dev/null 2>&1; echo $?",
            "set:sqsOk=${response}",
            "if(sqsOk!=0) && echo 'Error: aux4/queue-sqs is not installed. aux4/cloud-queue delegates to it -- run: aux4 aux4 pkger install aux4/queue-sqs' >&2 && exit 1 || true",
            "stdin:AWS_DEFAULT_REGION=value(region) aux4 queue sqs send --name value(cloudName) param(group)"
          ],
          "private": true,
          "help": {
            "text": "cloud provider: send a message (from stdin) to an env+scope-prefixed queue",
            "variables": [
              {
                "name": "env",
                "text": "aux4.cloud environment prefix for the underlying SQS queue name. Resolved from --env or the AUX4_CLOUD_ENV environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_ENV"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope prefix for the underlying SQS queue name. Resolved from --scope or the AUX4_CLOUD_SCOPE environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_SCOPE"
              },
              {
                "name": "region",
                "text": "AWS region for the underlying SQS queues",
                "default": "us-east-1"
              },
              {
                "name": "name",
                "text": "Queue name (final SQS name is <env>--<scope>--<name>, e.g. dev--myscope--jobs)",
                "default": ""
              },
              {
                "name": "group",
                "text": "Group key for one-at-a-time delivery. A random group is used per message when omitted",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "lease",
          "execute": [
            "if(env==) && echo 'Error: --env is required (or set AUX4_CLOUD_ENV) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "if(scope==) && echo 'Error: --scope is required (or set AUX4_CLOUD_SCOPE) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "nout:echo value(env) value(scope) value(name) | grep -q -- '--'; echo $?",
            "set:hasDoubleDash=${response}",
            "if(hasDoubleDash==0) && echo \"Error: --env/--scope/--name must not contain '--' (reserved as the queue-name field separator)\" && exit 1 || true",
            "set:cloudName=${env}--${scope}--${name}",
            "nout:aux4 queue sqs --help > /dev/null 2>&1; echo $?",
            "set:sqsOk=${response}",
            "if(sqsOk!=0) && echo 'Error: aux4/queue-sqs is not installed. aux4/cloud-queue delegates to it -- run: aux4 aux4 pkger install aux4/queue-sqs' >&2 && exit 1 || true",
            "AWS_DEFAULT_REGION=value(region) aux4 queue sqs lease --name value(cloudName) param(visibility)"
          ],
          "private": true,
          "help": {
            "text": "cloud provider: lease the next eligible message from an env+scope-prefixed queue",
            "variables": [
              {
                "name": "env",
                "text": "aux4.cloud environment prefix for the underlying SQS queue name. Resolved from --env or the AUX4_CLOUD_ENV environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_ENV"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope prefix for the underlying SQS queue name. Resolved from --scope or the AUX4_CLOUD_SCOPE environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_SCOPE"
              },
              {
                "name": "region",
                "text": "AWS region for the underlying SQS queues",
                "default": "us-east-1"
              },
              {
                "name": "name",
                "text": "Queue name (final SQS name is <env>--<scope>--<name>, e.g. dev--myscope--jobs)",
                "default": ""
              },
              {
                "name": "visibility",
                "text": "Visibility timeout in seconds",
                "default": "30"
              }
            ]
          }
        },
        {
          "name": "renew",
          "execute": [
            "if(env==) && echo 'Error: --env is required (or set AUX4_CLOUD_ENV) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "if(scope==) && echo 'Error: --scope is required (or set AUX4_CLOUD_SCOPE) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "nout:echo value(env) value(scope) value(name) | grep -q -- '--'; echo $?",
            "set:hasDoubleDash=${response}",
            "if(hasDoubleDash==0) && echo \"Error: --env/--scope/--name must not contain '--' (reserved as the queue-name field separator)\" && exit 1 || true",
            "set:cloudName=${env}--${scope}--${name}",
            "AWS_DEFAULT_REGION=value(region) aux4 queue sqs renew --name value(cloudName) param(leaseId) param(id) param(visibility)"
          ],
          "private": true,
          "help": {
            "text": "cloud provider: extend a still-live lease",
            "variables": [
              {
                "name": "env",
                "text": "aux4.cloud environment prefix for the underlying SQS queue name. Resolved from --env or the AUX4_CLOUD_ENV environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_ENV"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope prefix for the underlying SQS queue name. Resolved from --scope or the AUX4_CLOUD_SCOPE environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_SCOPE"
              },
              {
                "name": "region",
                "text": "AWS region for the underlying SQS queues",
                "default": "us-east-1"
              },
              {
                "name": "name",
                "text": "Queue name (final SQS name is <env>--<scope>--<name>, e.g. dev--myscope--jobs)",
                "default": ""
              },
              {
                "name": "leaseId",
                "text": "The leaseId returned by 'queue lease' (the SQS receipt handle)",
                "default": ""
              },
              {
                "name": "id",
                "text": "Alias for leaseId",
                "default": ""
              },
              {
                "name": "visibility",
                "text": "New visibility timeout in seconds, counted from now",
                "default": "30"
              }
            ]
          }
        },
        {
          "name": "ack",
          "execute": [
            "if(env==) && echo 'Error: --env is required (or set AUX4_CLOUD_ENV) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "if(scope==) && echo 'Error: --scope is required (or set AUX4_CLOUD_SCOPE) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "nout:echo value(env) value(scope) value(name) | grep -q -- '--'; echo $?",
            "set:hasDoubleDash=${response}",
            "if(hasDoubleDash==0) && echo \"Error: --env/--scope/--name must not contain '--' (reserved as the queue-name field separator)\" && exit 1 || true",
            "set:cloudName=${env}--${scope}--${name}",
            "AWS_DEFAULT_REGION=value(region) aux4 queue sqs ack --name value(cloudName) param(leaseId) param(id)"
          ],
          "private": true,
          "help": {
            "text": "cloud provider: delete a completed message",
            "variables": [
              {
                "name": "env",
                "text": "aux4.cloud environment prefix for the underlying SQS queue name. Resolved from --env or the AUX4_CLOUD_ENV environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_ENV"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope prefix for the underlying SQS queue name. Resolved from --scope or the AUX4_CLOUD_SCOPE environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_SCOPE"
              },
              {
                "name": "region",
                "text": "AWS region for the underlying SQS queues",
                "default": "us-east-1"
              },
              {
                "name": "name",
                "text": "Queue name (final SQS name is <env>--<scope>--<name>, e.g. dev--myscope--jobs)",
                "default": ""
              },
              {
                "name": "leaseId",
                "text": "The leaseId returned by 'queue lease' (the SQS receipt handle)",
                "default": ""
              },
              {
                "name": "id",
                "text": "Alias for leaseId",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "nack",
          "execute": [
            "if(env==) && echo 'Error: --env is required (or set AUX4_CLOUD_ENV) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "if(scope==) && echo 'Error: --scope is required (or set AUX4_CLOUD_SCOPE) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "nout:echo value(env) value(scope) value(name) | grep -q -- '--'; echo $?",
            "set:hasDoubleDash=${response}",
            "if(hasDoubleDash==0) && echo \"Error: --env/--scope/--name must not contain '--' (reserved as the queue-name field separator)\" && exit 1 || true",
            "set:cloudName=${env}--${scope}--${name}",
            "AWS_DEFAULT_REGION=value(region) aux4 queue sqs nack --name value(cloudName) param(leaseId) param(id)"
          ],
          "private": true,
          "help": {
            "text": "cloud provider: release a leased message for immediate redelivery",
            "variables": [
              {
                "name": "env",
                "text": "aux4.cloud environment prefix for the underlying SQS queue name. Resolved from --env or the AUX4_CLOUD_ENV environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_ENV"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope prefix for the underlying SQS queue name. Resolved from --scope or the AUX4_CLOUD_SCOPE environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_SCOPE"
              },
              {
                "name": "region",
                "text": "AWS region for the underlying SQS queues",
                "default": "us-east-1"
              },
              {
                "name": "name",
                "text": "Queue name (final SQS name is <env>--<scope>--<name>, e.g. dev--myscope--jobs)",
                "default": ""
              },
              {
                "name": "leaseId",
                "text": "The leaseId returned by 'queue lease' (the SQS receipt handle)",
                "default": ""
              },
              {
                "name": "id",
                "text": "Alias for leaseId",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "dlq",
          "execute": [
            "if(env==) && echo 'Error: --env is required (or set AUX4_CLOUD_ENV) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "if(scope==) && echo 'Error: --scope is required (or set AUX4_CLOUD_SCOPE) -- aux4/cloud-queue names queues <env>--<scope>--<name>' && exit 1 || true",
            "nout:echo value(env) value(scope) value(name) | grep -q -- '--'; echo $?",
            "set:hasDoubleDash=${response}",
            "if(hasDoubleDash==0) && echo \"Error: --env/--scope/--name must not contain '--' (reserved as the queue-name field separator)\" && exit 1 || true",
            "set:cloudName=${env}--${scope}--${name}",
            "nout:aux4 queue sqs --help > /dev/null 2>&1; echo $?",
            "set:sqsOk=${response}",
            "if(sqsOk!=0) && echo 'Error: aux4/queue-sqs is not installed. aux4/cloud-queue delegates to it -- run: aux4 aux4 pkger install aux4/queue-sqs' >&2 && exit 1 || true",
            "AWS_DEFAULT_REGION=value(region) aux4 queue sqs dlq --name value(cloudName) "
          ],
          "private": true,
          "help": {
            "text": "cloud provider: list up to 10 dead-letter messages for an env+scope-prefixed queue",
            "variables": [
              {
                "name": "env",
                "text": "aux4.cloud environment prefix for the underlying SQS queue name. Resolved from --env or the AUX4_CLOUD_ENV environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_ENV"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope prefix for the underlying SQS queue name. Resolved from --scope or the AUX4_CLOUD_SCOPE environment variable aux4.cloud machines set on deploy; required (no default) so a queue is never accidentally created unscoped",
                "default": "",
                "env": "AUX4_CLOUD_SCOPE"
              },
              {
                "name": "region",
                "text": "AWS region for the underlying SQS queues",
                "default": "us-east-1"
              },
              {
                "name": "name",
                "text": "Queue name (final SQS name is <env>--<scope>--<name>, e.g. dev--myscope--jobs)",
                "default": ""
              },
              {
                "name": "maxAttempts",
                "text": "Unused by this plugin; dead-lettering is enforced by the queue's own SQS redrive policy, set at create time",
                "default": "5"
              }
            ]
          }
        }
      ]
    }
  ]
}
